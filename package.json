{
  "name": "sevenboard",
  "version": "0.1.0",
  "private": true,
  "workspaces": [
    "apps/*",
    "packages/*"
  ],
  "scripts": {
    "dev": "npm run dev --workspaces --if-present",
    "dev:web": "npm run dev -w apps/web",
    "dev:api": "npm run dev -w apps/api",
    "build": "npm run build --workspaces --if-present",
    "db:generate": "npm run generate -w packages/database",
    "db:push": "npm run push -w packages/database",
    "db:migrate": "npm run migrate -w packages/database",
    "db:seed": "npm run seed -w packages/database",
    "lint": "npm run lint --workspaces --if-present"
  },
  "devDependencies": {
    "prisma": "^6.6.0",
    "typescript": "^5.5.0"
  },
  "overrides": {
    "@nestjs/platform-express": {
      "body-parser": "1.20.6",
      "multer": "2.3.0"
    },
    "@nestjs/common": { "file-type": "21.3.2" },
    "js-yaml@^4.0.0": "4.3.2",
    "lodash": "4.18.1",
    "@nestjs/schedule": { "uuid": "11.1.1" },
    "qs": "6.16.0",
    "esbuild": "0.28.2"
  },
  "dependencies": {
    "@prisma/client": "^6.6.0"
  }
}
